---
import Base from "../../layouts/Base.astro";
import GuideCard from "../../components/GuideCard.astro";
import { absolute, articlePath, articles, blogPath, homePath, LOCALES, t, ui, type Locale } from "../../lib/site";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const strings = t[locale];
const list = await articles(locale);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: strings.blogTitle,
  url: absolute(blogPath(locale)),
  inLanguage: locale,
  hasPart: list.map((entry) => ({ "@type": "Article", headline: entry.data.title, url: absolute(articlePath(locale, entry.topic)) })),
};
---
<Base locale={locale} title={strings.blogTitle} description={strings.blogDescription} path={blogPath(locale)} alternates={{ en: blogPath("en"), fr: blogPath("fr") }} jsonLd={jsonLd}>
  <header class="page-head">
    <div class="wrap">
      <nav class="crumbs" aria-label={locale === "fr" ? "Fil d’Ariane" : "Breadcrumb"}><a href={homePath(locale)}>{ui[locale].home}</a><span aria-hidden="true">/</span><span>{strings.blog}</span></nav>
      <h1>{strings.blogTitle}</h1>
      <p class="lede">{strings.blogDescription}</p>
    </div>
  </header>
  <section class="guides">
    <div class="wrap">
      <ul class="guide-grid">
        {list.map((entry) => <GuideCard entry={entry} />)}
      </ul>
    </div>
  </section>
</Base>
