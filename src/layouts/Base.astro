---
import { absolute, blogPath, homePath, t, type Locale } from "../lib/site";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  /** Equivalent page in each available language, including this one. */
  alternates: Partial<Record<Locale, string>>;
  jsonLd: Record<string, unknown>;
  type?: "website" | "article";
  modifiedAt?: string;
}

const { locale, title, description, path, alternates, jsonLd, type = "website", modifiedAt } = Astro.props;
const strings = t[locale];
const other: Locale = locale === "en" ? "fr" : "en";
const switchPath = alternates[other] ?? homePath(other);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absolute(path)} />
    {Object.entries(alternates).map(([lang, href]) => <link rel="alternate" hreflang={lang} href={absolute(href)} />)}
    {alternates.en && <link rel="alternate" hreflang="x-default" href={absolute(alternates.en)} />}
    <link rel="alternate" type="application/rss+xml" title={`${strings.siteName} — ${strings.rss}`} href={`/${locale}/rss.xml`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(path)} />
    <meta property="og:site_name" content={strings.siteName} />
    <meta property="og:locale" content={locale === "fr" ? "fr_FR" : "en_GB"} />
    {modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style is:global>
      :root {
        --ink: #1d2433;
        --muted: #5b6478;
        --line: #e3e6ee;
        --paper: #fbfbfd;
        --accent: #2f5bd3;
        --notice: #f3f5fb;
        color-scheme: light;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font: 17px/1.65 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      }
      a { color: var(--accent); }
      a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .wrap { max-width: 44rem; margin: 0 auto; padding: 0 16px; }
      header.site { border-bottom: 1px solid var(--line); background: #fff; }
      header.site .wrap { display: flex; gap: 1rem; align-items: center; justify-content: space-between; padding-block: 0.9rem; flex-wrap: wrap; }
      header.site nav { display: flex; gap: 1rem; font-size: 0.95rem; }
      .brand { font-weight: 700; color: var(--ink); text-decoration: none; }
      .notice { background: var(--notice); color: var(--muted); font-size: 0.85rem; padding: 0.6rem 0; }
      main { padding: 2rem 0 3rem; }
      h1 { font-size: clamp(1.7rem, 4vw, 2.3rem); line-height: 1.2; margin: 0 0 0.75rem; }
      h2 { font-size: 1.35rem; margin-top: 2.2rem; line-height: 1.3; }
      h3 { font-size: 1.1rem; margin-top: 1.6rem; }
      .lede { color: var(--muted); font-size: 1.1rem; margin-top: 0; }
      .meta { color: var(--muted); font-size: 0.9rem; }
      ul.cards { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 1.25rem; }
      ul.cards li { padding-bottom: 1.25rem; border-bottom: 1px solid var(--line); }
      ul.cards h2 { font-size: 1.2rem; margin: 0 0 0.3rem; }
      ul.cards h2 a { color: var(--ink); text-decoration: none; }
      ul.cards h2 a:hover { color: var(--accent); }
      ul.cards p { margin: 0; color: var(--muted); }
      article table { border-collapse: collapse; width: 100%; font-size: 0.95rem; display: block; overflow-x: auto; }
      article th, article td { border: 1px solid var(--line); padding: 0.45rem 0.6rem; text-align: left; vertical-align: top; }
      footer.site { border-top: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; padding: 1.5rem 0 2.5rem; }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={homePath(locale)}>{strings.siteName}</a>
        <nav aria-label={locale === "fr" ? "Navigation principale" : "Main navigation"}>
          <a href={blogPath(locale)}>{strings.allGuides}</a>
          <a href={switchPath} hreflang={other} lang={other}>{strings.switchTo}</a>
        </nav>
      </div>
    </header>
    <div class="notice" role="note"><div class="wrap">{strings.notice}</div></div>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        <p>{strings.notice}</p>
        <p><a href={`/${locale}/rss.xml`}>{strings.rss}</a> · <a href="/sitemap-index.xml">Sitemap</a></p>
      </div>
    </footer>
  </body>
</html>
