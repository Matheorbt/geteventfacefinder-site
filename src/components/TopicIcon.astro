---
import { ICONS, styleFor } from "../lib/site";
interface Props { topic: string; size?: "sm" | "lg" }
const { topic, size = "sm" } = Astro.props;
const { icon, tone } = styleFor(topic);
---
<span class={`topic-icon tone-${tone} size-${size}`} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={ICONS[icon]} /></svg>
</span>
