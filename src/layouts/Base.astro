---
import "../styles/global.css";
import { absolute, blogPath, homePath, t, type Locale } from "../lib/site";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  /** Equivalent page in each available language, including this one. */
  alternates: Partial<Record<Locale, string>>;
  jsonLd: Record<string, unknown>;
  type?: "website" | "article";
  modifiedAt?: string;
}

const { locale, title, description, path, alternates, jsonLd, type = "website", modifiedAt } = Astro.props;
const strings = t[locale];
const other: Locale = locale === "en" ? "fr" : "en";
const switchPath = alternates[other] ?? homePath(other);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absolute(path)} />
    {Object.entries(alternates).map(([lang, href]) => <link rel="alternate" hreflang={lang} href={absolute(href)} />)}
    {alternates.en && <link rel="alternate" hreflang="x-default" href={absolute(alternates.en)} />}
    <link rel="alternate" type="application/rss+xml" title={`${strings.siteName} — ${strings.rss}`} href={`/${locale}/rss.xml`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#faf6ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15171c" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(path)} />
    <meta property="og:site_name" content={strings.siteName} />
    <meta property="og:locale" content={locale === "fr" ? "fr_FR" : "en_GB"} />
    {modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={homePath(locale)}>
          <span class="brand-mark" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10" /></svg>
          </span>
          <span class="brand-text">{strings.siteName}</span>
        </a>
        <nav class="site-nav" aria-label={locale === "fr" ? "Navigation principale" : "Main navigation"}>
          <a class="all" href={blogPath(locale)}>{strings.allGuides}</a>
          <a class="lang" href={switchPath} hreflang={other} lang={other}>{other.toUpperCase()}<span class="sr-only"> — {strings.switchTo}</span></a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>{strings.notice}</p>
        <div class="footer-links">
          <a href={blogPath(locale)}>{strings.allGuides}</a>
          <a href={`/${locale}/rss.xml`}>{strings.rss}</a>
          <a href="/sitemap-index.xml">Sitemap</a>
          <a href={switchPath} hreflang={other} lang={other}>{strings.switchTo}</a>
        </div>
      </div>
    </footer>
    <style is:global>
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
    </style>
  </body>
</html>
